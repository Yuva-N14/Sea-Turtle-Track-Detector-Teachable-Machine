{
  "name": "sea-turtle-track-detector",
  "version": "1.0.0",
  "description": "Sea Turtle Track Detector",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac pkg --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.example.seaturtletracker",
    "productName": "Sea Turtle Track Detector",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "pkg",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "This app uses your camera to detect sea turtle tracks."
      }
    }
  }
}
